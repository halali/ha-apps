#!/usr/bin/with-contenv bash
# Make the add-on's PUID/PGID options real.
#
# Home Assistant writes add-on options to /data/options.json, but the
# LinuxServer base reads PUID/PGID from the *environment*, inside init-adduser,
# which runs long before anything in custom-cont-init.d. Nothing ever bridged
# the two, so both options were inert and the app kept the image default uid
# 911. Home Assistant's /media is a bind mount of a CIFS share owned by root
# with dir_mode 0755, and that uid can read and traverse such a mount but never
# write to it -- which is why an import could read the finished download and
# still fail to create the destination folder:
#
#   UnauthorizedAccessException: Access to the path
#   '/media/NAS/series/Reacher/Season 4' is denied.
#
# This oneshot is ordered ahead of init-adduser (the dependency is added in the
# Dockerfile) and rewrites the environment init-adduser goes on to read.
#
# It deliberately cannot fail. S6_BEHAVIOUR_IF_STAGE2_FAILS=2 turns any init
# error into a container exit, so a missing or malformed options.json must
# leave the Dockerfile's PUID/PGID=0 in place rather than stop the add-on.

apply_ids() {
    local var value
    for var in PUID PGID; do
        value="$(jq -r --arg k "$var" '.[$k] // empty' /data/options.json 2>/dev/null)" || return 0
        # Only a plain integer is honoured; anything else keeps the ENV default.
        if [[ "$value" =~ ^[0-9]+$ ]]; then
            printf '%s' "$value" > "/run/s6/container_environment/$var" 2>/dev/null || return 0
            echo "[ha-puid] $var=$value"
        fi
    done
}

if [[ -f /data/options.json && -d /run/s6/container_environment ]]; then
    apply_ids || true
else
    echo "[ha-puid] no options.json; keeping ENV defaults"
fi

exit 0
